# ==================== DATABASE ====================
# Neon Serverless Postgres connection string
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/database_name

# ==================== AUTHENTICATION ====================
# Secret key for JWT token signing (must be strong, min 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-min-32-chars

# ==================== APPLICATION ====================
# Public app URL for redirects and API calls
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development, production, or test)
NODE_ENV=development

# ==================== ML BACKEND ====================
# URL of the ML microservice for predictions
# Local development: http://127.0.0.1:8000
# Production: https://your-ml-backend-url
ML_SERVICE_URL=http://127.0.0.1:8000

# ==================== IMAGE HOSTING (CLOUDINARY) ====================
# Cloudinary cloud name (public, can be in NEXT_PUBLIC_*)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API credentials (keep secret)
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==================== EMAIL SERVICE (SMTP) ====================
# Disable email by omitting these variables
# SMTP host (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP port (typically 587 for TLS, 465 for SSL)
SMTP_PORT=587

# Email address for sending (e.g., noreply@yourdomain.com)
SMTP_EMAIL=your-email@gmail.com

# SMTP password or app-specific password
SMTP_PASSWORD=your-app-password

# Display name for emails (optional)
FROM_NAME=AI Healthcare

# From email address (optional, defaults to SMTP_EMAIL)
FROM_EMAIL=noreply@medai.com

# ==================== DEBUG & LOGGING ====================
# Enable debug logging for development
DEBUG=false
