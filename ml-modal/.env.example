# ==================== AUTHENTICATION ====================
# JWT Secret for token verification (must match frontend JWT_SECRET)
# This is shared between the frontend and ML backend for secure communication
JWT_SECRET=your-secret-key-min-32-chars

# ==================== ML BACKEND CONFIGURATION ====================
# FastAPI Server host and port
# Host: 0.0.0.0 for Docker/production, 127.0.0.1 for local development
ML_HOST=0.0.0.0
ML_PORT=8000

# ==================== DEVICE & PERFORMANCE ====================
# Device for model inference (auto-detect by default)
# Options: auto, cpu, cuda, mps (Metal Performance Shaders for Apple Silicon)
# Leave blank for auto-detection
DEVICE=auto

# Number of workers for data loading
NUM_WORKERS=4

# Batch size for inference
INFERENCE_BATCH_SIZE=16

# ==================== MODEL PATHS ====================
# Directory containing pre-trained models
# Models should be in: ml-modal/model_*.pth and ml-modal/risk_model.joblib
# Leave blank to use default (current directory)
MODELS_DIR=./

# Weights directory for model storage
WEIGHTS_DIR=./weights

# ==================== DATA MANAGEMENT ====================
# Directory for training/validation data
DATA_DIR=./data

# Output directory for results, heatmaps, and logs
OUTPUTS_DIR=./results

# Maximum upload size for images (in MB)
MAX_UPLOAD_SIZE_MB=50

# ==================== LOGGING & DEBUG ====================
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable detailed debug logging
DEBUG=False

# ==================== CORS & SECURITY ====================
# Allowed origins for CORS (comma-separated)
# Development: http://localhost:3000
# Production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# API Key for additional security (optional)
# If set, clients must include this in Authorization header as "Bearer {API_KEY}"
API_KEY=

# ==================== INFERENCE CONFIGURATION ====================
# Confidence threshold for predictions (0.0-1.0)
CONFIDENCE_THRESHOLD=0.5

# Enable model uncertainty estimation (MC Dropout)
ENABLE_UNCERTAINTY=True

# Number of MC Dropout samples for uncertainty
MC_DROPOUT_SAMPLES=10

# ==================== TRAINING CONFIGURATION ====================
# Default training parameters (can be overridden via API)
DEFAULT_EPOCHS=10
DEFAULT_BATCH_SIZE=16
DEFAULT_LEARNING_RATE=0.001

# Early stopping patience (number of epochs without improvement)
EARLY_STOPPING_PATIENCE=5

# ==================== NLP CONFIGURATION ====================
# Model name for NLP tasks
NLP_MODEL_NAME=biobert-base-cased

# Cache directory for downloaded models
NLP_CACHE_DIR=./models

# ==================== MONITORING & HEALTH ====================
# Enable Prometheus metrics
ENABLE_METRICS=False

# Health check timeout (seconds)
HEALTH_CHECK_TIMEOUT=10
